(base_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# React / Mini App. wasm-unsafe-eval is for rust-crypto; do not add unsafe-eval here.
# Keep this off the site-wide header block: browsers AND multiple CSPs, so a
# parent policy without unsafe-eval would still block Flutter's dart2js glue.
(spa_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://call.__MATRIX_DOMAIN__; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
}

# Flutter web: vodozemac/wasm-bindgen uses `new Function()` (needs unsafe-eval).
# COOP/COEP lets SharedArrayBuffer work for flutter_rust_bridge.
(flutter_csp) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://call.__MATRIX_DOMAIN__; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
	}
}

# Rendered to Caddyfile by deploy (replace MATRIX_DOMAIN placeholders) or kept
# in sync locally with the default domain. See docs/SECRETS.md.
__MATRIX_DOMAIN__ {
	import base_security_headers
	header {
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(self \"https://call.__MATRIX_DOMAIN__\"), microphone=(self \"https://call.__MATRIX_DOMAIN__\"), display-capture=(self \"https://call.__MATRIX_DOMAIN__\"), fullscreen=(self \"https://call.__MATRIX_DOMAIN__\"), geolocation=()"
	}
	encode zstd gzip

	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
		respond `{"m.server":"__MATRIX_DOMAIN__:443"}` 200
	}

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
		respond `{"m.homeserver":{"base_url":"https://__MATRIX_DOMAIN__"},"org.matrix.msc2965.authentication":{"issuer":"https://auth.__MATRIX_DOMAIN__/","account":"https://auth.__MATRIX_DOMAIN__/account/"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://rtc.__MATRIX_DOMAIN__/livekit/jwt"}]}` 200
	}

	# Legacy password login/logout/refresh (MAS compat). Registration is not
	# on Synapse: clients use MAS /register or OIDC prompt=create.
	@mas_compat path_regexp mas_compat ^/_matrix/client/(.*)/(login|logout|refresh)$
	handle @mas_compat {
		reverse_proxy mas:8080
	}

	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /flutter {
		redir /flutter/ 308
	}

	handle_path /flutter/* {
		import flutter_csp
		root * /srv/flutter
		try_files {path} /index.html
		file_server
	}

	handle /miniapp {
		redir /miniapp/ 308
	}

	handle_path /miniapp/* {
		import spa_csp
		root * /srv/miniapp
		try_files {path} /index.html
		file_server
	}

	handle /client {
		redir /client/ 308
	}

	handle_path /client/* {
		import spa_csp
		root * /srv/client
		file_server
	}

	handle_path /miniapp-api/* {
		reverse_proxy bot:8090
	}

	handle {
		import spa_csp
		root * /srv/react
		try_files {path} /index.html
		file_server
	}
}

auth.__MATRIX_DOMAIN__ {
	import base_security_headers
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Permissions-Policy "camera=(), microphone=(), display-capture=(), fullscreen=(), geolocation=()"
	}
	encode zstd gzip
	reverse_proxy mas:8080
}

call.__MATRIX_DOMAIN__ {
	import base_security_headers
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors https://__MATRIX_DOMAIN__; object-src 'none'; base-uri 'self'"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), geolocation=()"
	}
	encode zstd gzip
	reverse_proxy element-call:8080
}

rtc.__MATRIX_DOMAIN__ {
	import base_security_headers
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), display-capture=(), fullscreen=(), geolocation=()"
	}

	handle /livekit/jwt* {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		@jwt_options method OPTIONS
		handle @jwt_options {
			respond "" 204
		}
		uri strip_prefix /livekit/jwt
		reverse_proxy lk-jwt-service:8080 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
		}
	}

	handle /livekit/sfu* {
		uri strip_prefix /livekit/sfu
		reverse_proxy livekit:7880
	}

	handle /healthz {
		respond "ok" 200
	}
}

# Optional Matrix Push Gateway (Sygnal). Enable with:
#   docker compose -f docker-compose.prod.yml --profile push up -d
# DNS: A record push.__MATRIX_DOMAIN__ -> DEPLOY_PUBLIC_IP
# VITE_PUSH_GATEWAY_URL=https://push.__MATRIX_DOMAIN__/_matrix/push/v1/notify
# Raw ntfy is NOT a Matrix push gateway; do not point m.pusher at it.
push.__MATRIX_DOMAIN__ {
	import base_security_headers
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), display-capture=(), fullscreen=(), geolocation=()"
	}
	encode zstd gzip

	handle /_matrix/push/* {
		reverse_proxy sygnal:5000
	}

	handle /health {
		reverse_proxy sygnal:5000
	}

	handle /healthz {
		respond "ok" 200
	}
}

# Copy to .env only if you are not using scripts/stack.ps1.
# These placeholders are intentionally unusable for production.
POSTGRES_PASSWORD=replace-with-random-local-value
SYNAPSE_REGISTRATION_SECRET=replace-with-random-local-value
MAS_POSTGRES_PASSWORD=replace-with-random-local-value
MAS_MATRIX_SECRET=replace-with-random-local-value-at-least-32-chars
TURN_SHARED_SECRET=replace-with-random-local-value
LIVEKIT_KEY=replace-with-local-key
LIVEKIT_SECRET=replace-with-random-local-value
SYNAPSE_ENABLE_REGISTRATION=true

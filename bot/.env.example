# Homeserver Client-Server API (Conduit from ../server)
MATRIX_HOMESERVER=http://localhost:6167
MATRIX_USER_ID=@bot:localhost
MATRIX_PASSWORD=bot-pass

# Local http:// is refused unless this is true
ALLOW_INSECURE_HOMESERVER=true

# Keep crypto off for the lightest local loop; flip to true once Conduit+client E2EE is ready
MATRIX_CRYPTO=false

# E2EE showcase options (used when MATRIX_CRYPTO=true)
MATRIX_CRYPTO_STORE_PASSPHRASE=
MATRIX_KEY_BACKUP=false
MATRIX_KEY_BACKUP_RECOVERY_KEY=
MATRIX_BOOTSTRAP_CROSS_SIGNING=false
MATRIX_ONLY_TRUSTED_DEVICES=false
MATRIX_ROTATE_EVERY_MESSAGE=true
# Per-message Megolm rotate only when peer count ≤ this (aiomatrix 0.6 default 32).
MATRIX_ROTATE_EVERY_MESSAGE_MAX_PEERS=32
# Optional dispatcher timeout; aborts ctx.signal when > 0.
MATRIX_HANDLER_TIMEOUT_MS=0

# MiniApps require HTTPS except for localhost development.
MATRIX_MINIAPP_URL=http://localhost:4173/
MINIAPP_HTTP_PORT=8090
# Optional; aiomatrix persists a generated signing secret when omitted.
MATRIX_MINIAPP_SECRET=
# Comma-separated CORS allowlist for FormSpace HTTP. Defaults to the HS origin
# in production (https://testhighlife.strangled.net). Origin is reflected only
# when it matches this list.
MATRIX_MINIAPP_CORS_ORIGIN=http://localhost:4173

# Multi-instance signed callback/query stores (prod: redis://redis:6379).
REDIS_URL=

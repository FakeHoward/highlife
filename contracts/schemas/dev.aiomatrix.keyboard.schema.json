{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://highlife.example/contracts/dev.aiomatrix.keyboard.schema.json",
  "title": "dev.aiomatrix.keyboard",
  "type": "object",
  "required": ["version", "inline"],
  "properties": {
    "version": { "const": 1 },
    "fallback_command": { "type": "string", "minLength": 1 },
    "inline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "text", "data"],
              "properties": {
                "kind": { "const": "callback" },
                "text": { "type": "string", "minLength": 1, "maxLength": 128 },
                "data": { "type": "string" },
                "token": { "type": "string", "minLength": 1 },
                "style": { "enum": ["default", "primary", "danger", "link"] }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "text", "url"],
              "properties": {
                "kind": { "const": "url" },
                "text": { "type": "string", "minLength": 1, "maxLength": 128 },
                "url": { "type": "string", "pattern": "^https?://" },
                "style": { "enum": ["default", "primary", "danger", "link"] }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "text", "url"],
              "properties": {
                "kind": { "const": "mini_app" },
                "text": { "type": "string", "minLength": 1, "maxLength": 128 },
                "url": { "type": "string", "pattern": "^https?://" },
                "startParam": { "type": "string" },
                "style": { "enum": ["default", "primary", "danger", "link"] }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "text", "command"],
              "properties": {
                "kind": { "const": "command" },
                "text": { "type": "string", "minLength": 1, "maxLength": 128 },
                "command": { "type": "string", "minLength": 1 },
                "style": { "enum": ["default", "primary", "danger", "link"] }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
